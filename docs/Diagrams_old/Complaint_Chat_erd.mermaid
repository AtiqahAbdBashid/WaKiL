        string detail
    }
    CHAT_HISTORY {
        int id
        string citizen_id
        string messages
        int complaint_id
        Date closed_at
    }

    CITIZEN ||--o{ COMPLAINT : submits
    CITIZEN ||--o{ CHAT_HISTORY : owns
    STAFF ||--o{ COMPLAINT_UPDATE : writes
