# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# PostgreSQL connection string. Create the database, then load backend/sql/schema.sql
# and run backend/scripts/seed.py.
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/wakil

# MongoDB connection string used by the duplicate-detection and RAG services.
MONGODB_URL=mongodb://localhost:27017

# Secret that signs YB staff sign-in tokens (12 hours). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated on each start and staff are signed out on restart.
STAFF_TOKEN_SECRET=change-me-to-a-long-random-string
