# Copy this file to .env and adjust. Only variables starting with VITE_ reach the browser.

# Backend base URL. Optional in development: citizen calls default to http://localhost:8000
# and YB calls go through the Vite proxy (/api -> http://localhost:8000). Set it when the
# API runs on another host, e.g. in production.
VITE_API_URL=http://localhost:8000
